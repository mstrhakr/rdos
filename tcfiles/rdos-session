#!/bin/bash
set -u

MODE_DEFAULT="web"
SESSION_LOG="${HOME}/.session-launch.log"
fail_count=0

log() {
    printf '[rdos-session] %s\n' "$*"
}

read_mode_from_cmdline() {
    local token
    local cmdline

    if [ ! -r /proc/cmdline ]; then
        return 1
    fi

    cmdline="$(< /proc/cmdline)"
    for token in $cmdline; do
        case "$token" in
            rdos.ui=web)
                printf '%s\n' "web"
                return 0
                ;;
            rdos.ui=legacy)
                printf '%s\n' "legacy"
                return 0
                ;;
        esac
    done

    return 1
}

read_mode_from_tcconfig() {
    local key
    local value
    local cfg_path="${HOME}/tcconfig"

    [ -r "$cfg_path" ] || return 1

    while IFS='=' read -r key value || [ -n "$key" ]; do
        [ -z "$key" ] && continue
        case "$key" in
            ui_mode)
                value="${value#\"}"
                value="${value%\"}"
                value="${value,,}"
                if [ "$value" = "web" ] || [ "$value" = "legacy" ]; then
                    printf '%s\n' "$value"
                    return 0
                fi
                ;;
        esac
    done < "$cfg_path"

    return 1
}

start_udiskie() {
    if ! command -v udiskie >/dev/null 2>&1; then
        return 0
    fi

    if pgrep -u "$(id -u)" -x udiskie >/dev/null 2>&1; then
        return 0
    fi

    udiskie >/dev/null 2>&1 &
}

start_overlay() {
    if ! command -v /usr/bin/tc-overlay-daemon >/dev/null 2>&1; then
        return 0
    fi

    if pgrep -u "$(id -u)" -x tc-overlay-daemon >/dev/null 2>&1; then
        return 0
    fi

    /usr/bin/tc-overlay-daemon -tcconfig="${HOME}/tcconfig" -log="${HOME}/.tc-overlay.log" >/dev/null 2>&1 &
}

run_session() {
    local mode="$MODE_DEFAULT"

    if detected_mode="$(read_mode_from_cmdline 2>/dev/null)"; then
        mode="$detected_mode"
    elif detected_mode="$(read_mode_from_tcconfig 2>/dev/null)"; then
        mode="$detected_mode"
    fi

    log "Selected mode: $mode"
    start_udiskie

    if [ "$mode" = "web" ]; then
        /usr/bin/tc-ui-launch >>"$SESSION_LOG" 2>&1
        return $?
    fi

    start_overlay
    /usr/bin/fvwm >>"$SESSION_LOG" 2>&1
    return $?
}

while true; do
    run_session
    session_rc=$?

    if [ "$session_rc" -eq 0 ]; then
        sleep 1
        continue
    fi

    fail_count=$((fail_count + 1))
    warning_msg="session exited with status ${session_rc}; retrying."
    printf '[rdos-session] %s\n' "$warning_msg" >&2

    if command -v logger >/dev/null 2>&1; then
        logger -t rdos-session "$warning_msg"
    fi

    if [ -s "$SESSION_LOG" ] && { [ "$fail_count" -eq 1 ] || [ $((fail_count % 5)) -eq 0 ]; }; then
        printf '%s\n' '--- recent ~/.session-launch.log ---' >&2
        tail -n 40 "$SESSION_LOG" >&2
        printf '%s\n' '--- end ~/.session-launch.log ---' >&2
    fi

    sleep 2
done